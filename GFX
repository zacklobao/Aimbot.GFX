    closeBtn.MouseButton1Click:Connect(TogglePanel)
    toggleBtn.MouseEnter:Connect(function() Tween(toggleBtn, TweenInfo.new(0.15), { BackgroundColor3 = Theme.PrimaryDark }) end)
    toggleBtn.MouseLeave:Connect(function() Tween(toggleBtn, TweenInfo.new(0.15), { BackgroundColor3 = Theme.Primary }) end)

    tabs["OTIMIZAR"].btn.BackgroundColor3 = Theme.Primary
    tabs["OTIMIZAR"].btn.TextColor3 = Theme.Text
    tabs["OTIMIZAR"].frame.Visible = true

    -- Inputs
    UserInput.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.KeyCode == Enum.KeyCode.RightShift then TogglePanel() end
        if AimbotConfig.Keybind == input.KeyCode and AimbotConfig.Enabled then
            aiming = true
            stickyTarget = nil
            stickyTime = 0
            forceShiftLock(true)
        end
        if input.UserInputType == Enum.UserInputType.MouseButton2 and AimbotConfig.Keybind == "MB2" and AimbotConfig.Enabled then
            aiming = true
            stickyTarget = nil
            stickyTime = 0
            forceShiftLock(true)
        end
    end)
    UserInput.InputEnded:Connect(function(input)
        if AimbotConfig.Keybind == input.KeyCode then
            aiming = false
            forceShiftLock(false)
            stickyTarget = nil
        end
        if input.UserInputType == Enum.UserInputType.MouseButton2 and AimbotConfig.Keybind == "MB2" then
            aiming = false
            forceShiftLock(false)
            stickyTarget = nil
        end
    end)

    -- ✅ NOVO: botão flutuante separado para AIMBOT no mobile (segurar e mirar)
    if isMobile then
        local aimBtn = Create("TextButton", {
            Name = "AimBtn",
            Size = UDim2.new(0, 60, 0, 60),
            Position = UDim2.new(1, -80, 0.6, 0),
            BackgroundColor3 = Theme.Danger,
            Text = "🎯",
            TextColor3 = Theme.Text,
            Font = Enum.Font.GothamBold,
            TextSize = 28,
            AutoButtonColor = false,
            BorderSizePixel = 0,
            Parent = screenGui
        })
        Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = aimBtn })
        Create("UIStroke", { Color = Color3.fromRGB(180, 40, 40), Thickness = 2, Parent = aimBtn })

        aimBtn.InputBegan:Connect(function(input)
            if isPress(input) then
                aiming = true
                stickyTarget = nil
                stickyTime = 0
                forceShiftLock(true)
            end
        end)
        aimBtn.InputEnded:Connect(function(input)
            if isPress(input) then
                aiming = false
                forceShiftLock(false)
                stickyTarget = nil
            end
        end)
    end

    return screenGui, panel
end

