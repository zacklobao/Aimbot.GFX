local function DisableEffects(className)
    local count = 0
    for _, inst in ipairs(workspace:GetDescendants()) do
        if inst:IsA(className) and (inst.Enabled ~= nil) and inst.Enabled then
            if not disabledCache[inst] then
                disabledCache[inst] = { original = inst.Enabled }
            end
            pcall(function() inst.Enabled = false end)
            count = count + 1
        end
    end
    return count
end

local function RestoreEffects(className)
    local count = 0
    for inst, data in pairs(disabledCache) do
        if inst:IsA(className) and inst.Parent then
            pcall(function() inst.Enabled = data.original end)
            count = count + 1
        end
    end
    return count
end

local function HideDecoratives(strictness)
    local count = 0
    for _, inst in ipairs(workspace:GetDescendants()) do
        if inst:IsA("BasePart") and IsDecorative(inst) then
            local s = inst.Size
            local vol = s.X * s.Y * s.Z
            local threshold = (strictness == 1) and 8 or (strictness == 2) and 30 or 100
            if vol <= threshold then
                if not hiddenCache[inst] then
                    hiddenCache[inst] = {
                        LocalTransparencyModifier = inst.LocalTransparencyModifier,
                        Transparency = inst.Transparency
                    }
                end
                pcall(function()
                    inst.LocalTransparencyModifier = 1
                    inst.Transparency = 1
                end)
                count = count + 1
            end
        end
    end
    return count
end

-- ✅ NOVO: esconder SurfaceAppearance (texturas PBR - pesa MUITO)
local function HideSurfaceAppearance()
    for _, inst in ipairs(workspace:GetDescendants()) do
        if inst:IsA("SurfaceAppearance") then
            if not hiddenCache[inst] then
                hiddenCache[inst] = { Parent = inst.Parent }
            end
            pcall(function() inst.Parent = nil end)
        end
    end
end

-- ✅ NOVO: esconder Atmosphere/Clouds/Sky
local function HideAtmospheric()
    for _, obj in ipairs(Lighting:GetChildren()) do
        if obj:IsA("Atmosphere") or obj:IsA("Clouds") or obj:IsA("Sky") then
            if not hiddenCache[obj] then
                hiddenCache[obj] = { Parent = obj.Parent }
            end
            pcall(function() obj.Parent = nil end)
        end
    end
end

-- ✅ NOVO: esconder acessórios de outros jogadores (chapéus, cabelos)
local function HideAccessories()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            for _, item in ipairs(plr.Character:GetDescendants()) do
                if item:IsA("Accessory") or item:IsA("Hat") or item:IsA("Shirt") 
                   or item:IsA("Pants") or item:IsA("ShirtGraphic") then
                    if not hiddenCache[item] then
                        hiddenCache[item] = { Parent = item.Parent }
                    end
                    pcall(function() item.Parent = nil end)
                end
            end
        end
    end
end

