-- ✅ NOVO: salvar/restaurar CameraType (CRUCIAL pro mobile)
local function saveCameraState()
    if not savedCameraType then
        savedCameraType = Camera.CameraType
    end
end

local function restoreCameraState()
    if savedCameraType then
        pcall(function() Camera.CameraType = savedCameraType end)
        savedCameraType = nil
    end
end

local function forceShiftLock(state)
    if not AimbotConfig.ForceShiftLock then return end
    if state then
        pcall(function() UserInput.MouseBehavior = Enum.MouseBehavior.LockCenter end)
        pcall(function() LocalPlayer.DevEnableMouseLock = true end)
        saveCameraState()
        pcall(function() Camera.CameraType = Enum.CameraType.Scriptable end)
    else
        pcall(function() UserInput.MouseBehavior = Enum.MouseBehavior.Default end)
        restoreCameraState()
    end
end

local function getTargetPart(char, partName)
    if partName == "Nearest" then
        local closest, bestDist = nil, math.huge
        local camPos = Camera.CFrame.Position
        for _, part in ipairs(char:GetChildren()) do
            if part:IsA("BasePart") then
                local d = (part.Position - camPos).Magnitude
                if d < bestDist then bestDist = d; closest = part end
            end
        end
        return closest
    end
    return char:FindFirstChild(partName) or char:FindFirstChild("HumanoidRootPart")
end

local function isVisible(part)
    if not AimbotConfig.WallCheck then return true end
    local origin = Camera.CFrame.Position
    local dir = part.Position - origin
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { LocalPlayer.Character, Camera }
    local result = workspace:Raycast(origin, dir, params)
    return result == nil or result.Instance:IsDescendantOf(part.Parent)
end

local function angleToTarget(part)
    local camPos = Camera.CFrame.Position
    local lookDir = Camera.CFrame.LookVector
    local dirTo = (part.Position - camPos).Unit
    local dot = math.clamp(lookDir:Dot(dirTo), -1, 1)
    return math.deg(math.acos(dot))
end

local function isValidTarget(tbl)
    if not tbl then return false end
    local plr, part = tbl.plr, tbl.part
    if not plr or not part or not part.Parent then return false end
    local char = plr.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if AimbotConfig.TeamCheck and plr.Team == LocalPlayer.Team and plr.Team ~= nil then return false end
    local dist = (part.Position - Camera.CFrame.Position).Magnitude
    if dist > AimbotConfig.MaxDistance then return false end
    if not isVisible(part) then return false end
    return true
end

-- ✅ NOVO: busca do alvo (2 modos: por ângulo 3D OU por posição na tela)
local function getClosestToCursor()
    if AimbotConfig.Sticky and stickyTarget and isValidTarget(stickyTarget) then
        stickyTime = stickyTime + 1
        if stickyTime < 120 then return stickyTarget end
    end

    local best, bestScore = nil, math.huge
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local maxScreen = AimbotConfig.FOV / 2

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local char = plr.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if char and hum and hum.Health > 0 then
                if not (AimbotConfig.TeamCheck and plr.Team == LocalPlayer.Team and plr.Team ~= nil) then
                    local part = getTargetPart(char, AimbotConfig.TargetPart)
                    if part then
                        local dist3D = (part.Position - Camera.CFrame.Position).Magnitude
                        if dist3D <= AimbotConfig.MaxDistance and isVisible(part) then
                            -- ✅ MODO MOBILE: por tela
                            if AimbotConfig.MobileSearchByScreen and isMobile then
                                local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
                                if onScreen and screenPos.Z > 0 then
                                    local d = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                                    if d < maxScreen and d < bestScore then
                                        bestScore = d
                                        best = { plr = plr, part = part }
                                    end
                                end
                            else
                                -- MODO ÂNGULO 3D (PC)
                                local ang = angleToTarget(part)
                                if ang <= AimbotConfig.AimFOVDegree and ang < bestScore then
                                    bestScore = ang
                                    best = { plr = plr, part = part }
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    if best then
        stickyTarget = best
        stickyTime = 0
    end
    return best
end

local function predictPosition(part)
    local pos = part.Position
    if not AimbotConfig.Prediction then return pos end
    local vel = part.AssemblyLinearVelocity
    if vel.Magnitude < 1 then return pos end
    local dist = (pos - Camera.CFrame.Position).Magnitude
    local bulletSpeed = 600
    return pos + vel * (dist / bulletSpeed)
end

-- ✅ Mira via CFrame direto (funciona no mobile)
local function applyAim(target)
    if not target or not target.part then return end
    local aimPos = predictPosition(target.part)
    local camPos = Camera.CFrame.Position
    local targetCF = CFrame.new(camPos, aimPos)
    local alpha = math.clamp(AimbotConfig.Smoothness, 0.01, 1)
    pcall(function() Camera.CFrame = Camera.CFrame:Lerp(targetCF, alpha) end)
end

-- ✅ Mira via mousemoverel (PC)
local function applyAimMouse(target)
    if not target or not target.part then return end
    local aimPos = predictPosition(target.part)
    local camPos = Camera.CFrame.Position
    local targetCF = CFrame.new(camPos, aimPos)
    local deltaCF = Camera.CFrame:ToObjectSpace(targetCF)
    local _, _, _, _, _, _, _, m22, m23, _, m32, m33 = deltaCF:GetComponents()
    local yaw = math.atan2(-m32, m33)
    local pitch = math.asin(math.clamp(m23, -1, 1))
    local alpha = math.clamp(AimbotConfig.Smoothness, 0.01, 1)
    if mousemoverel then
        pcall(function() mousemoverel(math.deg(yaw) * alpha * 0.5, math.deg(pitch) * alpha * 0.5) end)
    end
end

local function aimbotStep()
    -- ✅ FOV circle: no mobile fica no CENTRO, no PC segue o mouse
    if fovCircle then
        if AimbotConfig.ShowFOVCircle then
            fovCircle.Visible = true
            local size = AimbotConfig.FOV
            local mp
            if isMobile then
                mp = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
            else
                mp = UserInput:GetMouseLocation()
            end
            fovCircle.Position = UDim2.fromOffset(mp.X - size/2, mp.Y - size/2)
            fovCircle.Size = UDim2.fromOffset(size, size)
            fovCircle.UIStroke.Color = AimbotConfig.FOVColor
        else
            fovCircle.Visible = false
        end
    end

    if not AimbotConfig.Enabled or not aiming then return end

    local target = getClosestToCursor()
    if not target then return end

    if AimbotConfig.MobileMode and isMobile then
        applyAim(target)
    elseif AimbotConfig.UseMouseMove and mousemoverel then
        applyAimMouse(target)
    else
        applyAim(target)
    end

    if AimbotConfig.AutoShoot then
        pcall(function()
            if mouse1click then mouse1click() end
            if isMobile and VirtualUser then VirtualUser:ClickButton1(Vector2.new()) end
        end)
    end
end

pcall(function() RunService:UnbindFromRenderStep(bindedName) end)
RunService:BindToRenderStep(bindedName, Enum.RenderPriority.Camera.Value + 1, aimbotStep)

