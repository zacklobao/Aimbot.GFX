local function ApplyProfile(profileName)
    CreateBackup()
    local cfg = Profiles[profileName]
    if not cfg then return false end

    if hasSetFPS and cfg.fps then pcall(function() setfpscap(cfg.fps) end) end
    pcall(function() settings().Rendering.QualityLevel = cfg.quality end)

    for _, effect in ipairs(Lighting:GetChildren()) do
        if effect:IsA("PostEffect") then
            if cfg.post then
                if not disabledCache[effect] then
                    disabledCache[effect] = { original = effect.Enabled }
                end
                effect.Enabled = false
            else
                if disabledCache[effect] then effect.Enabled = disabledCache[effect].original end
            end
        end
    end

    if cfg.particles then DisableEffects("ParticleEmitter") else RestoreEffects("ParticleEmitter") end
    if cfg.trails then DisableEffects("Trail"); DisableEffects("Beam")
    else RestoreEffects("Trail"); RestoreEffects("Beam") end

    Lighting.GlobalShadows = not cfg.shadows
    if cfg.shadows then
        Lighting.ShadowSoftness = 0
        Lighting.FogEnd = 350
        pcall(function()
            Lighting.EnvironmentDiffuseScale = 0
            Lighting.EnvironmentSpecularScale = 0
        end)
    end

    if cfg.decals then DisableEffects("Decal"); DisableEffects("Texture")
    else RestoreEffects("Decal"); RestoreEffects("Texture") end

    if cfg.skybox then HideAtmospheric() end
    if cfg.atmosphere then HideAtmospheric() end
    if cfg.surfaceAppearance then HideSurfaceAppearance() end
    if cfg.accessories then HideAccessories() end

    if cfg.terrainDecoration then
        pcall(function()
            workspace.Terrain.Decoration = false
            workspace.Terrain.WaterWaveSize = 0
            workspace.Terrain.WaterWaveSpeed = 0
        end)
    end

    if cfg.decoratives and cfg.decoratives > 0 then
        HideDecoratives(cfg.decoratives)
    end

    -- ✅ Reduzir FOV da câmera melhora FPS em mobile
    if cfg.cameraFOV then
        pcall(function() Camera.FieldOfView = cfg.cameraFOV end)
    end

    isOptimizing = true
    print("[GFX] Perfil aplicado:", profileName)
    return true
end

local function StartContinuousOptimization(profileName)
    isOptimizing = true
    task.spawn(function()
        while isOptimizing do
            local count = 0
            count = count + DisableEffects("ParticleEmitter")
            count = count + DisableEffects("Trail")
            count = count + DisableEffects("Beam")
            local cfg = Profiles[profileName]
            if cfg then
                if cfg.decoratives > 0 then count = count + HideDecoratives(cfg.decoratives) end
                if cfg.surfaceAppearance then HideSurfaceAppearance() end
                if cfg.accessories then HideAccessories() end
            end
            task.wait(4)
        end
    end)
end

