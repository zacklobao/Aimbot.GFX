local originalSettings = nil
local disabledCache    = {}
local hiddenCache      = {}
local isOptimizing     = false

local function CreateBackup()
    if originalSettings then return originalSettings end
    originalSettings = {
        Lighting = {
            GlobalShadows = Lighting.GlobalShadows,
            FogEnd = Lighting.FogEnd,
            Ambient = Lighting.Ambient,
            OutdoorAmbient = Lighting.OutdoorAmbient,
            Brightness = Lighting.Brightness,
            ClockTime = Lighting.ClockTime,
            ShadowSoftness = Lighting.ShadowSoftness,
            EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale,
            EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale
        },
        Camera = {
            MaxZoomDistance = Camera.MaxZoomDistance,
            FieldOfView = Camera.FieldOfView
        },
        Quality = settings().Rendering.QualityLevel,
        Effects = {},
        Terrain = {
            Decoration = workspace.Terrain.Decoration,
            WaterWaveSize = workspace.Terrain.WaterWaveSize,
            WaterWaveSpeed = workspace.Terrain.WaterWaveSpeed
        }
    }
    for _, effect in ipairs(Lighting:GetChildren()) do
        if effect:IsA("PostEffect") then
            originalSettings.Effects[effect] = effect.Enabled
        end
    end
    return originalSettings
end

local function RestoreBackup()
    if not originalSettings then return end
    for prop, val in pairs(originalSettings.Lighting) do
        pcall(function() Lighting[prop] = val end)
    end
    for prop, val in pairs(originalSettings.Camera) do
        pcall(function() Camera[prop] = val end)
    end
    pcall(function() settings().Rendering.QualityLevel = originalSettings.Quality end)
    for effect, enabled in pairs(originalSettings.Effects) do
        if effect and effect.Parent then effect.Enabled = enabled end
    end
    for prop, val in pairs(originalSettings.Terrain) do
        pcall(function() workspace.Terrain[prop] = val end)
    end
    for inst, data in pairs(disabledCache) do
        if inst and inst.Parent then
            pcall(function() inst.Enabled = data.original end)
        end
    end
    disabledCache = {}
    for inst, data in pairs(hiddenCache) do
        if inst and inst.Parent then
            for prop, val in pairs(data) do
                pcall(function() inst[prop] = val end)
            end
        end
    end
    hiddenCache = {}
    if hasSetFPS then pcall(function() setfpscap(240) end) end
    isOptimizing = false
    print("[GFX] Configurações restauradas!")
end

