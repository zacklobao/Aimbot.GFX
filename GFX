local function isSameTeam(plr)
    if not ESPConfig.TeamCheck then return false end
    return plr.Team == LocalPlayer.Team and plr.Team ~= nil
end

local function updateESPForPlayer(plr)
    local obj = ESPObjects[plr]
    if not obj then return end
    local char = plr.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    if not ESPConfig.Enabled or not char or not hum or not hrp or hum.Health <= 0 or isSameTeam(plr) then
        obj.Box.Visible = false; obj.HealthBG.Visible = false
        obj.Name.Visible = false; obj.Dist.Visible = false; obj.Tracer.Visible = false
        return
    end

    local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
    if dist > ESPConfig.MaxDistance then
        obj.Box.Visible = false; obj.HealthBG.Visible = false
        obj.Name.Visible = false; obj.Dist.Visible = false; obj.Tracer.Visible = false
        return
    end

    local cf, size = char:GetBoundingBox()
    local topWorld = cf * CFrame.new(0, size.Y/2, 0)
    local bottomWorld = cf * CFrame.new(0, -size.Y/2, 0)

    local topScreen, onTop = Camera:WorldToViewportPoint(topWorld.Position)
    local bottomScreen, onBottom = Camera:WorldToViewportPoint(bottomWorld.Position)
    if not (onTop and onBottom) then
        obj.Box.Visible = false; obj.HealthBG.Visible = false
        obj.Name.Visible = false; obj.Dist.Visible = false; obj.Tracer.Visible = false
        return
    end

    local heightPx = math.abs(bottomScreen.Y - topScreen.Y)
    local widthPx = heightPx * 0.55
    local x = topScreen.X - widthPx / 2
    local y = topScreen.Y

    if ESPConfig.ShowBox then
        obj.Box.Visible = true
        obj.Box.Position = UDim2.fromOffset(x, y)
        obj.Box.Size = UDim2.fromOffset(widthPx, heightPx)
        obj.Box.UIStroke.Color = ESPConfig.TeamColor and (plr.TeamColor and plr.TeamColor.Color or ESPConfig.BoxColor) or ESPConfig.BoxColor
    else obj.Box.Visible = false end

    if ESPConfig.ShowHealth then
        obj.HealthBG.Visible = true
        obj.HealthBG.Position = UDim2.fromOffset(x - 6, y)
        obj.HealthBG.Size = UDim2.fromOffset(4, heightPx)
        local ratio = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
        obj.HealthFill.Size = UDim2.new(1, 0, ratio, 0)
        obj.HealthFill.Position = UDim2.new(0, 0, 1 - ratio, 0)
        obj.HealthFill.BackgroundColor3 = Color3.fromRGB(255,0,0):Lerp(Color3.fromRGB(0,255,0), ratio)
    else obj.HealthBG.Visible = false end

    if ESPConfig.ShowName then
        obj.Name.Visible = true
        obj.Name.Text = plr.Name .. " [" .. math.floor(hum.Health) .. "]"
        obj.Name.Position = UDim2.fromOffset(x - 20, y - 18)
        obj.Name.Size = UDim2.fromOffset(widthPx + 40, 16)
    else obj.Name.Visible = false end

    if ESPConfig.ShowDistance then
        obj.Dist.Visible = true
        obj.Dist.Text = math.floor(dist) .. "m"
        obj.Dist.Position = UDim2.fromOffset(x - 20, y + heightPx + 2)
        obj.Dist.Size = UDim2.fromOffset(widthPx + 40, 14)
    else obj.Dist.Visible = false end

    if ESPConfig.ShowTracer then
        obj.Tracer.Visible = true
        local origin = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
        local target = Vector2.new(x + widthPx/2, y + heightPx)
        local delta = target - origin
        local len = delta.Magnitude
        local mid = origin + delta/2
        local angle = math.deg(math.atan2(delta.Y, delta.X))
        obj.Tracer.Position = UDim2.fromOffset(mid.X, mid.Y)
        obj.Tracer.Size = UDim2.fromOffset(len, 1)
        obj.Tracer.Rotation = angle
    else obj.Tracer.Visible = false end
end

