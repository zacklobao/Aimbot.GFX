local DECORATIVE_KEYWORDS = {
    "grass","foliage","bush","leaves","leaf","flower","plant","vine","decor",
    "decoration","detail","pebble","small","tiny","clutter","cloud","smoke",
    "sparkle","shine","glow","hint","dust","confetti","debris","rubble","moss",
    "ivy","weed","seed","pollen","fog","shadow","ambient","trash","litter",
    "scrap","crack","stain"
}
local PROTECTED_KEYWORDS = {
    "base","baseplate","floor","ground","wall","roof","door","gate","humanoid",
    "character","torso","head","limb","arm","leg","hitbox","collision","physics",
    "weapon","gun","sword","vehicle","wheel","car","truck","bike","ball","goal",
    "net","hoop","basket","spawn","checkpoint","trigger","kill","damage","core",
    "engine","camera","light","spot","surface","spawnlocation","flag","banner"
}
local DECORATIVE_MATERIALS = {
    [Enum.Material.Grass] = true,
    [Enum.Material.LeafyGrass] = true,
    [Enum.Material.Fabric] = true,
    [Enum.Material.Sand] = true,
    [Enum.Material.Snow] = true,
    [Enum.Material.Mud] = true,
}

local function nameContains(name, list)
    local lname = name:lower()
    for _, kw in ipairs(list) do
        if lname:find(kw, 1, true) then return true end
    end
    return false
end

local function isCharacterDescendant(inst)
    if LocalPlayer.Character and inst:IsDescendantOf(LocalPlayer.Character) then return true end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character and inst:IsDescendantOf(plr.Character) then return true end
    end
    return false
end

local function IsDecorative(inst)
    if not inst or not inst.Parent then return false end
    if isCharacterDescendant(inst) then return false end
    if inst == workspace.Terrain then return false end
    if nameContains(inst.Name, PROTECTED_KEYWORDS) then return false end
    if nameContains(inst.Name, DECORATIVE_KEYWORDS) then return true end
    if inst:IsA("BasePart") then
        if inst.CanCollide == false then
            local s = inst.Size
            local vol = s.X * s.Y * s.Z
            if vol < 8 then return true end
            if DECORATIVE_MATERIALS[inst.Material] and vol < 40 then return true end
        end
    end
    if inst:IsA("Decal") or inst:IsA("Texture") then return true end
    return false
end

